# Copy this file to `.env` and fill in real values for local development.
# Never commit a real .env file.

APP_NAME="SupportOps AI"
ENVIRONMENT=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://supportops:supportops@localhost:5432/supportops_ai

# Redis is ephemeral infrastructure only (rate limiting, idempotency keys,
# workflow checkpoints, AI/knowledge caches) -- never the system of record.
# If it's unreachable, the app degrades gracefully rather than failing;
# see backend/core/README.md.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_CHECKPOINT_TTL_SECONDS=3600
REDIS_CLASSIFICATION_CACHE_TTL_SECONDS=3600
REDIS_KNOWLEDGE_CACHE_TTL_SECONDS=900

POSTGRES_USER=supportops
POSTGRES_PASSWORD=supportops
POSTGRES_DB=supportops_ai

# TODO: generate a strong secret and inject via a real secrets manager for
# anything beyond local development.
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
